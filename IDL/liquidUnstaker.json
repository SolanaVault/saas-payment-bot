            "name": "rate_history_epochs",
            "docs": [
              "Up to 5 epochs of recorded SOL/LST exchange rates (scaled by RATE_SCALE).",
              "Rate = total_lamports * RATE_SCALE / pool_token_supply.",
              "Populated by sync_inventory as a ring buffer (oldest evicted when full).",
              "",
              "Used as the baseline for the drift-check validation applied to sell_lst, buy_lst,",
              "and unstake_pool_lsts: trades are rejected if the current rate deviates from the",
              "most recent recorded rate by more than pool.max_rate_drift_bps. The full history",
              "is retained for diagnostics and operator investigation (see record_rate /",
              "last_recorded_rate)."
            ],
            "type": {
              "array": ["u64", 5]
            }
