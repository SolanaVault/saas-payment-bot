            "name": "min_buy_lamports",
            "docs": [
              "Minimum total cost (lamports) required for buy_lst; 0 disables the check."
            ],
            "type": "u64"
          },
          {
            "name": "max_rate_drift_bps",
            "docs": [
              "Maximum allowed drift (basis points, 100% = FEE_PCT_DIVISOR) between the current",
              "SOL/LST exchange rate and the most recently recorded rate in LstInfo.rate_history.",
              "Applied by sell_lst, buy_lst, and unstake_pool_lsts to reject trades when the",
              "underlying stake pool's rate has changed unexpectedly (compromise, inflation attack,",
              "or slashing beyond expected bounds). Capped by MAX_RATE_DRIFT_BPS_CAP."
            ],
            "type": "u16"
          },
          {
            "name": "halted_at_epoch",
            "docs": [
              "Emergency halt state. Some(epoch) means all user-facing operations are blocked",
              "starting from epoch, UNTIL HALT_MAX_EPOCHS epochs have passed, at which point",
              "the halt auto-expires and operations resume. None means not halted.",
              "The admin can re-halt when a halt expires. Auto-expiry prevents funds from being",
              "locked indefinitely if the admin becomes unresponsive (key loss, infrastructure",
              "failure, malicious intent)."
            ],
            "type": {
              "option": "u64"
            }
          },
          {
            "name": "maintenance_authority",
            "docs": [
              "Authority allowed to run maintenance operations that keep pool accounting fresh and",
              "move pool-owned LST inventory into deactivating stake."
            ],
            "type": "pubkey"
          }
        ]
      }
